# EI-GAP Environment Variables
# Copy this file and fill in the values.
# Required vars will cause a startup error if missing.

# OpenRouter (REQUIRED)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001

# Site (REQUIRED)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CTA_URL=

# OpenRouter Options (OPTIONAL)
# OPENROUTER_TIMEOUT_MS=30000
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_FALLBACK_MODEL=

# Rate Limiting (OPTIONAL)
# RATE_LIMIT_PER_IP=5

# Supabase (OPTIONAL -- Phase 5)
# All three must be set for Supabase to be enabled.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
